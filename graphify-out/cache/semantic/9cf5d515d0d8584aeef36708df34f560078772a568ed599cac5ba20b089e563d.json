      "file_type": "rationale",
      "source_file": ".claude/skills/graphify/references/extraction-spec.md",
      "source_location": "confidence_score is REQUIRED",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Discrete set of values (0.95, 0.85, 0.75, 0.65, 0.55) chosen because models follow discrete rubrics better than continuous ranges; bimodal distribution (>50% at 0.5, >40% at 0.85+) was observed in production when using range guidance."
